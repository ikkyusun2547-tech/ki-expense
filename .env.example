# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ถูก commit)
# ระบบรันบนเครื่องของบริษัท ไม่ใช้บริการภายนอก

# --- ฐานข้อมูล PostgreSQL บนเครื่องนี้ ---
DATABASE_URL="postgresql://internet_expense:PASSWORD@localhost:5432/internet_expense"
# รหัส superuser "postgres" (เก็บไว้ให้ผู้ดูแลเครื่อง แอปไม่ได้ใช้)
POSTGRES_SUPERUSER_PASSWORD=""

# --- seed: admin คนแรก (ต้องเปลี่ยนรหัสตอนล็อกอินครั้งแรก) ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="ผู้ดูแลระบบ"
SEED_ADMIN_PASSWORD=""

# --- port ของระบบจริง (scripts\start-app.ps1; dev ใช้ 3000) ---
# PORT="8080"

# --- cookie ล็อกอิน: ระบบจริงใช้ http ในวงแลน จึงต้องตั้ง false (deploy.ps1 ตั้งให้แล้ว) ---
# COOKIE_SECURE="false"

# --- โฟลเดอร์เก็บไฟล์ใบแจ้งหนี้ (นอกโฟลเดอร์โค้ด เพื่อสำรองข้อมูลแยกได้) ---
UPLOAD_DIR="C:/InternetExpenseData/invoices"
