// ระบบเบิกค่าอินเทอร์เน็ต — บริษัท น้ำตาลสุรินทร์ จำกัด
// วันที่ทุกช่องที่เป็น @db.Date เก็บเป็น ค.ศ. (ISO) ไม่มีเวลา
// constraint ที่ Prisma เขียนไม่ได้ (exclusion, check, trigger) อยู่ใน migration SQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR // ผู้จัดทำ
  ACCOUNTING // ฝ่ายบัญชี
  APPROVER // ผู้อนุมัติ — กดอนุมัติใบเบิกที่เลือกตนเป็นผู้อนุมัติ
  ADMIN
}

enum CenterStatus {
  ACTIVE // ใช้งาน
  MOVED // ย้าย (เฉพาะศูนย์)
  CLOSED // ปิด / เบอร์โทรศัพท์ = ยกเลิก
}

// ประเภทค่าใช้จ่ายของรายการในทะเบียน
enum ServiceKind {
  INTERNET // ค่าอินเทอร์เน็ต — ทะเบียนศูนย์
  PHONE // ค่าโทรศัพท์ — ทะเบียนเบอร์โทรศัพท์
}

enum RequestStatus {
  CREATED // สร้างแล้ว
  PENDING // รออนุมัติ
  APPROVED // อนุมัติแล้ว (เข้าคิวฝ่ายบัญชี) — เดิมชื่อ SENT "ส่งบัญชีแล้ว"
  PAID // จ่ายแล้ว
}

enum LogAction {
  CREATE
  EDIT
  DELETE
  SEND // เลิกใช้ (ก่อนมีการอนุมัติในระบบ) — คงไว้เพราะ log เก่าลบไม่ได้
  SUBMIT // ส่งขออนุมัติ
  APPROVE
  REJECT // ไม่อนุมัติ → กลับเป็นสร้างแล้ว
  PAY
  REVERT
}

// ล็อกอินด้วยชื่อผู้ใช้ + รหัสผ่านของระบบเอง (ไม่พึ่งบริการภายนอก)
model User {
  id                 String   @id @default(cuid())
  username           String   @unique // เก็บเป็นตัวพิมพ์เล็ก
  name               String
  title              String? // ตำแหน่ง — พิมพ์ใต้ชื่อในใบเบิก (บังคับสำหรับผู้จัดทำ/ผู้อนุมัติ)
  email              String? // ไว้ส่งแจ้งเตือน (ถ้ามี)
  passwordHash       String // scrypt — ดู src/server/password.ts
  mustChangePassword Boolean  @default(true) // บังคับเปลี่ยนรหัสหลังล็อกอินครั้งแรก/admin รีเซ็ต
  role               Role
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requests          Request[]     @relation("RequestCreatedBy")
  requesterRequests Request[]     @relation("RequestRequester")
  approverRequests  Request[]     @relation("RequestApprover")
  logs              ApprovalLog[]
  sessions          Session[]
}

// session ล็อกอิน — cookie เก็บ token, DB เก็บแค่ sha256 ของ token
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ประวัติการล็อกอิน ใช้จำกัดการลองรหัสผิดและตรวจย้อนหลัง
model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// ทะเบียนรายการที่เบิกได้ (ชื่อตารางเดิม = ศูนย์ เพราะเริ่มจากค่าอินเทอร์เน็ต) — ความหมายของช่องขึ้นกับ kind
model Center {
  id            String       @id @default(cuid())
  kind          ServiceKind  @default(INTERNET)
  customerCode  String       @unique // รหัสค้นหา: อินเทอร์เน็ต = รหัสลูกค้า 3BB, โทรศัพท์ = หมายเลขโทรศัพท์ (ตัวเลขล้วน)
  serviceNumber String? // ข้อมูลประกอบ: อินเทอร์เน็ต = หมายเลขบริการ, โทรศัพท์ = รหัสลูกค้าของค่าย
  provider      String       @default("") // ระบบ/ค่าย เช่น TRUE (โทรศัพท์)
  name          String // อินเทอร์เน็ต = ชื่อศูนย์, โทรศัพท์ = ผู้ใช้บริการ (ฝ่าย)
  normalAmount  Decimal      @db.Decimal(12, 2) // ยอดปกติต่อเดือน
  dueDay        Int // วันครบกำหนดประจำเดือน 1-31
  status        CenterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  requests Request[]
}

model Request {
  id              String        @id @default(cuid())
  centerId        String
  invoiceNo       String
  amount          Decimal       @db.Decimal(12, 2)
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  status          RequestStatus @default(CREATED)
  paidDate        DateTime?     @db.Date
  paymentRef      String?
  invoiceFileKey  String?
  invoiceFileName String?
  // ผู้ลงนามของใบนี้ = บัญชีผู้ใช้ (ผู้ขอ: ผู้จัดทำ, ผู้อนุมัติ: บทบาท APPROVER)
  // + สำเนาชื่อ/ตำแหน่ง ณ ตอนเลือก ให้พิมพ์ซ้ำได้เหมือนเดิมแม้ภายหลังแก้ชื่อ/ตำแหน่งของผู้ใช้
  // requesterId null = ผู้จัดทำที่สร้างใบ (ตำแหน่งจากผู้ใช้ หรือค่าตั้ง); approverId null = ยังไม่เลือก (ส่งขออนุมัติไม่ได้)
  requesterId     String?
  requesterName   String?
  requesterTitle  String?
  approverId      String?
  approverName    String?
  approverTitle   String?
  approvedAt      DateTime? // เวลาที่ผู้อนุมัติกดอนุมัติ — พิมพ์ในใบเบิก
  // ข้อความหัวบันทึกของใบนี้ (ผู้จัดทำกรอกในฟอร์ม ค่าเริ่มต้น = ใบล่าสุดของตน) — แทนหน้าตั้งค่ากลางที่เลิกใช้
  department      String // จาก (ฝ่าย) — ใช้ในย่อหน้า "... ขอเบิกค่าใช้บริการ" ด้วย
  recipient       String // เรียน
  purpose         String // เพื่อ
  createdById     String
  deletedAt       DateTime? // soft delete: ลบได้เฉพาะสถานะ CREATED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  center    Center        @relation(fields: [centerId], references: [id], onDelete: Restrict)
  createdBy User          @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  requester User?         @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver  User?         @relation("RequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  logs      ApprovalLog[]

  @@index([centerId, periodStart])
  @@index([status, dueDate])
  @@index([approverId, status])
}

// ประวัติการเปลี่ยนสถานะ เพิ่มอย่างเดียว (trigger ใน DB ปฏิเสธ UPDATE/DELETE)
model ApprovalLog {
  id         String         @id @default(cuid())
  requestId  String
  action     LogAction
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  actorId    String
  note       String?
  createdAt  DateTime       @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
